# =============================================================================
# TMPMAS — Environment Configuration Example
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
#
#     cp .env.example .env
#
# `.env` is git-ignored; `.env.example` is committed and shows what's expected.
# =============================================================================

# --- PostgreSQL ---------------------------------------------------------------
# Used by the `db` service in ops/compose/docker-compose.yml
POSTGRES_USER=tmpmas
POSTGRES_PASSWORD=tmpmas_dev_password
POSTGRES_DB=tmpmas
POSTGRES_PORT=5432

# --- Application --------------------------------------------------------------
# Runtime environment name (development | staging | production)
TMPMAS_ENV=development

# Logging level (DEBUG | INFO | WARNING | ERROR)
TMPMAS_LOG_LEVEL=DEBUG

# --- External data sources (placeholders; filled in Phase 5) ------------------
# FIXTURE_API_KEY=changeme
# ODDS_API_KEY=changeme
